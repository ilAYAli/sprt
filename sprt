DEFAULT_REFERENCE = "~/assets/engines/reference"
DEFAULT_BOOK = (
    "~/assets/books/AntiDraw_V2.1/WOMP_Openings_V1/"
    "WOMP_V1_+150_+159/WOMP_V1_6mvs_big_+140_+169.epd"
)
DEFAULT_GAMES = 2000
ENGINE_ID_TIMEOUT = 2.0


class SprtHelpFormatter(argparse.ArgumentDefaultsHelpFormatter):
    def __init__(self, prog: str) -> None:
        super().__init__(prog, max_help_position=32, width=120)

    def _get_help_string(self, action: argparse.Action) -> str:
        help_text = action.help or ""
        if "%(default)" in help_text:
            return help_text
        if action.default is True:
            return f"{help_text} (default: enabled)"
        if action.default is False:
            return f"{help_text} (default: disabled)"
        if action.default is None:
            return help_text
        if action.default == "":
            return f"{help_text} (default: empty)"
        if action.default == []:
            return f"{help_text} (default: none)"
        return super()._get_help_string(action)


def command_stdout(cmd: list[str]) -> str:
    try:
        proc = subprocess.run(cmd, text=True, capture_output=True, check=False, timeout=2)
    except (OSError, subprocess.SubprocessError):
        return ""
    if proc.returncode != 0:
        return ""
    return proc.stdout.strip()


def command_int(cmd: list[str]) -> Optional[int]:
    text = command_stdout(cmd)
    try:
        return int(text.splitlines()[0])
    except (IndexError, ValueError):
        return None


def detect_linux_physical_cores() -> Optional[int]:
    text = command_stdout(["lscpu", "-p=Core,Socket"])
    cores: set[tuple[str, str]] = set()
    for line in text.splitlines():
        if not line or line.startswith("#"):
            continue
        parts = line.split(",")
        if len(parts) >= 2:
            cores.add((parts[0], parts[1]))
    return len(cores) if cores else None


def detect_apple_pcores() -> Optional[int]:
    if platform.system() != "Darwin" or platform.machine() != "arm64":
        return None
    return command_int(["sysctl", "-n", "hw.perflevel0.physicalcpu"])


def auto_sprt_defaults() -> tuple[int, int, str]:
    if pcores := detect_apple_pcores():
        concurrency = pcores - 2 if pcores >= 8 else pcores
        return max(1, concurrency), 1, f"Apple Silicon {pcores}P auto"

    cores = detect_linux_physical_cores() or os.cpu_count() or 1
    return max(1, cores), 1, f"{cores}-core auto"


def parse_args() -> argparse.Namespace:
    auto_concurrency, auto_threads, auto_reason = auto_sprt_defaults()
    parser = argparse.ArgumentParser(
        description="Run an SPRT with fastchess",
        formatter_class=SprtHelpFormatter,
    )
    parser.add_argument("--candidate", "-c", required=True,
                        help="candidate UCI engine executable")
    parser.add_argument("--reference", "-r", default=DEFAULT_REFERENCE,
                        help="reference UCI engine executable")
    parser.add_argument("--candidate-opts", action="append", default=[], metavar="ARGS",
                        help="extra process args for the candidate engine; repeatable")
    parser.add_argument("--reference-opts", action="append", default=[], metavar="ARGS",
                        help="extra process args for the reference engine; repeatable")
    parser.add_argument("--candidate-uci", action="append", default=[], metavar="NAME=VAL",
                        help="extra UCI option for the candidate engine; repeatable")
    parser.add_argument("--reference-uci", action="append", default=[], metavar="NAME=VAL",
                        help="extra UCI option for the reference engine; repeatable")
    parser.add_argument("--book", default=DEFAULT_BOOK,
                        help="opening book file")
    parser.add_argument("--games", type=int, default=DEFAULT_GAMES,
                        help="target number of games")
    parser.add_argument("--concurrency", type=int, default=None,
                        help=f"parallel games; default: auto ({auto_concurrency}, {auto_reason})")
    parser.add_argument("--threads", "-t", type=int, default=None,
                        help=f"engine Threads option; default: auto ({auto_threads}, {auto_reason})")
    parser.add_argument("--tc", default="10+0.1",
                        help="fastchess time control passed to -each")
    parser.add_argument("--book-format", default="epd",
                        help="fastchess opening book format")
    parser.add_argument("--fastchess", default="",
                        help="fastchess executable path; empty searches PATH")
    parser.add_argument("--log-dir", default="logs",
                        help="directory for raw fastchess logs and PGNs")
    parser.add_argument("--ntfy-url", default=os.environ.get("SPRT_NTFY_URL", ""),
                        help="ntfy topic URL for start/end notifications")
    parser.add_argument("--ai-stdout-url", default=os.environ.get("SPRT_AI_STDOUT_URL", ""),
                        help="ntfy topic URL for final user-visible summaries")
    parser.add_argument("--no-ntfy", action="store_true",
                        help="suppress all ntfy notifications; use only for distributed shards")
    parser.add_argument("--name", "-n", default="sprt",
                        help="run name used for log and PGN filenames")
    parser.add_argument("--elo0", type=float, default=0.0, help="SPRT null hypothesis Elo")
    parser.add_argument("--elo1", type=float, default=10.0, help="SPRT test hypothesis Elo")
    parser.add_argument("--alpha", type=float, default=0.05, help="SPRT false-positive rate")
    parser.add_argument("--beta", type=float, default=0.05, help="SPRT false-negative rate")
    parser.add_argument("--restart", choices=["on", "off"], default="on",
                        help="fastchess engine restart mode")
    parser.add_argument("--order", default="random",
                        help="fastchess opening order")
    parser.add_argument("--srand", default="",
                        help="fastchess random seed; empty lets fastchess choose")
    eta_group = parser.add_mutually_exclusive_group()
    eta_group.add_argument("--eta", dest="eta", action="store_true", default=True, help="always show progress ETA")
    eta_group.add_argument("--no-eta", dest="eta", action="store_false", default=argparse.SUPPRESS,
                           help="hide progress ETA")
    argv, candidate_opts, reference_opts = extract_process_opts(sys.argv[1:], parser)
    args = parser.parse_args(argv)
    args.candidate_opts = parse_process_opts(candidate_opts, "--candidate-opts")
    args.reference_opts = parse_process_opts(reference_opts, "--reference-opts")
    if args.no_ntfy:
        args.ntfy_url = ""
        args.ai_stdout_url = ""
    return args


def extract_process_opts(
    argv: list[str],
    parser: argparse.ArgumentParser,
) -> tuple[list[str], list[str], list[str]]:
    filtered = []
    candidate_opts = []
    reference_opts = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--candidate-opts":
            if i + 1 >= len(argv):
                parser.error("--candidate-opts expected one argument")
            candidate_opts.append(argv[i + 1])
            i += 2
            continue
        if arg.startswith("--candidate-opts="):
            candidate_opts.append(arg.split("=", 1)[1])
            i += 1
            continue
        if arg == "--reference-opts":
            if i + 1 >= len(argv):
                parser.error("--reference-opts expected one argument")
            reference_opts.append(argv[i + 1])
            i += 2
            continue
        if arg.startswith("--reference-opts="):
            reference_opts.append(arg.split("=", 1)[1])
            i += 1
            continue
        filtered.append(arg)
        i += 1
    return filtered, candidate_opts, reference_opts


def parse_process_opts(values: list[str], label: str) -> list[str]:
    parsed = []
    for value in values:
        try:
            parsed.extend(shlex.split(value))
        except ValueError as ex:
            print(f"{label} is invalid: {ex}", file=sys.stderr)
            sys.exit(1)
    return parsed


def expand_user_paths(args: argparse.Namespace) -> None:
    args.candidate = os.path.expanduser(args.candidate)
    args.reference = os.path.expanduser(args.reference)
    args.book = os.path.expanduser(args.book)
    args.fastchess = os.path.expanduser(args.fastchess)
    args.log_dir = os.path.expanduser(args.log_dir)
    args.candidate_opts = [os.path.expanduser(opt) for opt in args.candidate_opts]
    args.reference_opts = [os.path.expanduser(opt) for opt in args.reference_opts]


def resolve_auto_defaults(args: argparse.Namespace) -> str:
    concurrency, threads, reason = auto_sprt_defaults()
    source = auto_default_label(reason)
    changed = []
    args.concurrency_source = ""
    args.threads_source = ""
    if args.concurrency is None:
        args.concurrency = concurrency
        args.concurrency_source = source
        changed.append("concurrency")
    if args.threads is None:
        args.threads = threads
        args.threads_source = source
        changed.append("threads")
    return reason if changed else "explicit"


def auto_default_label(reason: str) -> str:
    if reason.startswith("Apple Silicon"):
        return "macOS default"
    return "auto default"


def find_fastchess(path: str) -> list[str]:
    if path:
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return [path]
        print(f"fastchess is not executable: {path}", file=sys.stderr)
        sys.exit(1)

    found = shutil.which("fastchess")
    if found:
        return [found]

    print("fastchess not found in PATH; pass --fastchess to specify it", file=sys.stderr)
    sys.exit(1)


def require_executable(path: str, label: str) -> None:
    if not os.path.isfile(path) or not os.access(path, os.X_OK):
        print(f"{label} engine is not executable: {path}", file=sys.stderr)
        sys.exit(1)


def require_file(path: str, label: str) -> None:
    if not os.path.isfile(path):
        print(f"{label} not found: {path}", file=sys.stderr)
        sys.exit(1)


def engine_display(command: str, process_opts: list[str]) -> str:
    if not process_opts:
        return command
    return f"{command} {shlex.join(process_opts)}"


def engine_id(command: str, process_opts: list[str]) -> str:
    try:
        proc = subprocess.Popen(
            [command, *process_opts],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
        )
    except OSError:
        return ""

    try:
        stdout, _ = proc.communicate("uci\nquit\n", timeout=ENGINE_ID_TIMEOUT)
    except subprocess.TimeoutExpired:
        proc.kill()
        stdout, _ = proc.communicate()

    lines = [line.strip() for line in stdout.splitlines() if line.strip()]
    for line in lines:
        if line.startswith("id name "):
            return line.removeprefix("id name ").strip()
    for line in lines:
        if line.startswith("id ") and not line.startswith("id author "):
            return line.removeprefix("id ").strip()
    return ""


def add_engine_header(lines: list[str], role: str, command: str, process_opts: list[str]) -> None:
    display = engine_display(command, process_opts)
    name = engine_id(command, process_opts)
    if name:
        lines.append(f"{role}: {display} ({name})")
        return
    lines.append(f"{role}: {display}")


def run_field(name: str, value: object, source: str = "") -> str:
    field = f"{name}: {value}"
    if source:
        return f"{field} ({source})"
    return field


def startup_message(args: argparse.Namespace) -> str:
    lines: list[str] = []
    add_engine_header(lines, "candidate", args.candidate, args.candidate_opts)
    add_engine_header(lines, "reference", args.reference, args.reference_opts)
    lines.extend([
        run_field("games", args.games),
        run_field("tc", args.tc),
        run_field("concurrency", args.concurrency, getattr(args, "concurrency_source", "")),
        run_field("threads", args.threads, getattr(args, "threads_source", "")),
        run_field("elo", f"{args.elo0:g}/{args.elo1:g}"),
    ])
    return "\n".join(lines)


def load_ntfy_auth() -> str:
    if os.environ.get("NTFY_AUTH"):
        return os.environ["NTFY_AUTH"]
    if os.environ.get("LICHESS_NTFY_AUTH"):
        return os.environ["LICHESS_NTFY_AUTH"]

    ntfy_file = Path.home() / ".ntfy"
    if not ntfy_file.is_file():
        return ""

    for line in ntfy_file.read_text(errors="ignore").splitlines():
        line = line.strip()
        if line.startswith("export "):
            line = line[7:]
        if line.startswith("NTFY_AUTH="):
            value = line.split("=", 1)[1].strip()
        elif line.startswith("LICHESS_NTFY_AUTH="):
            value = line.split("=", 1)[1].strip()
        else:
            continue
        if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
            value = value[1:-1]
        return value
    return ""


def post_ntfy(url: str, message: str, *, title: str = "") -> bool:
    if not url:
        return True

    data = message.encode()
    req = urllib.request.Request(url, data=data, method="POST")
    if title:
        req.add_header("Title", title)
    auth = load_ntfy_auth()
    if auth:
        token = base64.b64encode(auth.encode()).decode()
        req.add_header("Authorization", f"Basic {token}")

    try:
        urllib.request.urlopen(req, timeout=10).close()
    except (OSError, urllib.error.URLError):
        print(f"ntfy post failed: {url}", file=sys.stderr)
        return False
    return True


def engine_args(name: str, command: str, process_opts: list[str], threads: int, restart: str,
                extra_options: list[str]) -> list[str]:
    args = [
        "-engine",
        f"name={name}",
        "proto=uci",
        f"restart={restart}",
        f"cmd={command}",
        f"option.Threads={threads}",
    ]
    if process_opts:
        args.append(f"args={shlex.join(process_opts)}")
    args.extend(f"option.{opt}" for opt in extra_options)
    return args


def build_command(args: argparse.Namespace, log_pgn: Path) -> list[str]:
    rounds = max(1, (args.games + 1) // 2)
    cmd = find_fastchess(args.fastchess)
    cmd += [
        "-openings",
        f"file={args.book}",
        f"format={args.book_format}",
        f"order={args.order}",
        *engine_args("candidate", args.candidate, args.candidate_opts, args.threads,
                     args.restart, args.candidate_uci),
        *engine_args("reference", args.reference, args.reference_opts, args.threads,
                     args.restart, args.reference_uci),
        "-concurrency",
        str(args.concurrency),
        "-ratinginterval",
        "2",
        "-rounds",
        str(rounds),
        "-repeat",
        "-pgnout",
        f"file={log_pgn}",
        "notation=san",
        "append=false",
        "-each",
        f"tc={args.tc}",
        "-recover",
        "-output",
        "format=cutechess",
        "-sprt",
        f"elo0={args.elo0:g}",
        f"elo1={args.elo1:g}",
        f"alpha={args.alpha:g}",
        f"beta={args.beta:g}",
    ]
    if args.srand:
        cmd += ["-srand", args.srand]
    return cmd


NOISY_FASTCHESS_PREFIXES = (
    "Warning; Bestmove does not match beginning of last PV",
    "Warning; No info line available to extract score from engine",
    "Warning; PV continues after fifty-move rule",
    "Info; info depth",
    "Position; fen",
    "Moves;",
)


SCORE_RE = re.compile(
    r"^Score of candidate vs reference: "
    r"(?P<wins>\d+) - (?P<losses>\d+) - (?P<draws>\d+)"
    r"\s+\[(?P<rate>[0-9.]+)\]\s+(?P<completed>\d+)"
)
ELO_RE = re.compile(
    r"^Elo difference: (?P<elo>[-0-9.inf]+) \+/- (?P<err>[-0-9.nan]+), "
    r"LOS: (?P<los>[-0-9.nan]+) %, DrawRatio: (?P<draw>[-0-9.]+) %"
)
SPRT_RE = re.compile(r"^SPRT: llr (?P<llr>[-0-9.]+).*ubound (?P<ubound>[-0-9.inf]+)")


def format_decimal(value: str, decimals: int) -> str:
    try:
        number = float(value)
    except ValueError:
        return value
    if number != number or number in (float("inf"), float("-inf")):
        return value
    return f"{number:.{decimals}f}"


def format_field(value: str, decimals: int, width: int) -> str:
    return f"{format_decimal(value, decimals):>{width}}"


def format_llr(llr: str, ubound: str) -> str:
    try:
        llr_value = float(llr)
        ubound_value = float(ubound)
    except ValueError:
        return llr
    if ubound_value != ubound_value or ubound_value in (0.0, float("inf"), float("-inf")):
        return llr
    pct = llr_value / abs(ubound_value) * 100.0
    if abs(pct) < 0.5:
        pct = 0.0
    return f"{llr_value:>5.2f}/{ubound_value:.2f} ({pct:>3.0f}%)"


def format_eta(seconds: float) -> str:
    seconds = max(0, int(seconds + 0.5))
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    if hours:
        return f"{hours}h{minutes:02d}m"
    if minutes:
        return f"{minutes}m{seconds:02d}s"
    return f"{seconds}s"


class ProgressFormatter:
    def __init__(self, total_games: int, show_eta: Optional[bool]) -> None:
        self.total_games = total_games
        self.show_eta = show_eta
        self.start_time = time.monotonic()
        self.score: Optional[re.Match[str]] = None
        self.elo: Optional[re.Match[str]] = None

    def eta(self, completed: int) -> str:
        if completed <= 0:
            return "?"
        remaining = max(0, self.total_games - completed)
        elapsed = time.monotonic() - self.start_time
        return format_eta(elapsed * remaining / completed)

    def format(self, line: str) -> Optional[str]:
        if line.startswith(NOISY_FASTCHESS_PREFIXES):
            return None
        if line.startswith("Started game ") or line.startswith("Finished game "):
            return None

        if match := SCORE_RE.match(line):
            self.score = match
            return None
        if match := ELO_RE.match(line):
            self.elo = match
            return None
        if match := SPRT_RE.match(line):
            if not self.score or not self.elo:
                return line
            width = len(str(self.total_games))
            completed = int(self.score["completed"])
            progress_line = (
                f"[{completed:>{width}}/{self.total_games}] "
                f"Elo {format_field(self.elo['elo'], 1, 5)} +/- {format_field(self.elo['err'], 1, 5)} | "
                f"LLR {format_llr(match['llr'], match['ubound'])} | "
                f"LOS {format_field(self.elo['los'], 1, 4)}% | "
                f"draw {format_field(self.elo['draw'], 1, 5)}%"
            )
            progress_with_eta = f"{progress_line} | ETA {self.eta(completed)}"
            terminal_width = shutil.get_terminal_size((120, 20)).columns
            if self.show_eta is True or (self.show_eta is None and len(progress_with_eta) <= terminal_width):
                return f"{progress_with_eta}\n"
            return f"{progress_line}\n"

        if line.startswith("Player:") or line.startswith("   \""):
            return None
        return line


def run_and_tee(cmd: list[str], log: Path, total_games: int, show_eta: Optional[bool]) -> int:
    with log.open("w") as log_file:
        progress = ProgressFormatter(total_games, show_eta)
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        assert proc.stdout is not None
        for line in proc.stdout:
            printable = progress.format(line)
            if printable is not None:
                print(printable, end="", flush=True)
            log_file.write(line)
            log_file.flush()
        return proc.wait()


def last_matching_line(log: Path, prefix: str) -> str:
    result = ""
    if not log.is_file():
        return result
    for line in log.read_text(errors="ignore").splitlines():
        if line.startswith(prefix):
            result = line
    return result


def main() -> int:
    args = parse_args()
    expand_user_paths(args)
    resolve_auto_defaults(args)

    require_executable(args.candidate, "Candidate")
    require_executable(args.reference, "Reference")
    require_file(args.book, "Opening book")

    logs_dir = Path(args.log_dir)
    logs_dir.mkdir(exist_ok=True)
    log = logs_dir / f"{args.name}.log"
    pgn = logs_dir / f"{args.name}.pgn"

    start_msg = startup_message(args)
    print(f"{start_msg}\n")
    post_ntfy(args.ntfy_url, start_msg)

    status = run_and_tee(build_command(args, pgn), log, args.games, args.eta)

    time.sleep(1)
    score_line = last_matching_line(log, "Score of candidate vs reference")
    elo_line = last_matching_line(log, "Elo difference")
    sprt_line = last_matching_line(log, "SPRT: llr")
    summary = "\n".join([
        score_line or "no final score",
        elo_line or "no Elo",
        sprt_line or "no SPRT line",
        f"Log: {log}",
    ])
    final_message = f"SPRT {args.name} ({status}):\n{summary}"
    post_ntfy(args.ntfy_url, final_message, title="SPRT finished")
    post_ntfy(args.ai_stdout_url, final_message, title="SPRT finished")

    return status


if __name__ == "__main__":
    raise SystemExit(main())
