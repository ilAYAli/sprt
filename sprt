def format_decimal(value: str, decimals: int) -> str:
    try:
        number = float(value)
    except ValueError:
        return value
    if number != number or number in (float("inf"), float("-inf")):
        return value
    return f"{number:.{decimals}f}"


def format_field(value: str, decimals: int, width: int) -> str:
    return f"{format_decimal(value, decimals):>{width}}"


def format_llr(llr: str, ubound: str) -> str:
    try:
        llr_value = float(llr)
        ubound_value = float(ubound)
    except ValueError:
        return llr
    if ubound_value != ubound_value or ubound_value in (0.0, float("inf"), float("-inf")):
        return llr
    pct = llr_value / abs(ubound_value) * 100.0
    if abs(pct) < 0.5:
        pct = 0.0
    return f"{llr_value:>5.2f}/{ubound_value:.2f} ({pct:>3.0f}%)"


def format_eta(seconds: float) -> str:
    seconds = max(0, int(seconds + 0.5))
    hours, seconds = divmod(seconds, 3600)
    minutes, seconds = divmod(seconds, 60)
    if hours:
        return f"{hours}h{minutes:02d}m"
    if minutes:
        return f"{minutes}m{seconds:02d}s"
    return f"{seconds}s"


RESUME_SCHEMA = "sprt.resume.v1"


def normalize_home(value: str) -> str:
    home = str(Path.home())
    return "~" + value[len(home):] if home and value.startswith(home) else value


def resume_params(args: argparse.Namespace) -> dict[str, object]:
    """Settings that determine which games a shard plays; compared on resume.

    Paths are normalised so a shard killed on one host resumes on another.
    Concurrency only changes speed, so it is not part of the identity.
    """
    def engine(command: str, opts: list[str], uci: list[str]) -> dict[str, object]:
        return {
            "id": engine_id(command, opts) or Path(command).name,
            "opts": [normalize_home(item) for item in opts],
            "uci": [normalize_home(item) for item in uci],
        }

    return {
        "candidate": engine(args.candidate, args.candidate_opts, args.candidate_uci),
        "reference": engine(args.reference, args.reference_opts, args.reference_uci),
        "book": Path(args.book).name,
        "book_format": args.book_format,
        "book_offset": args.book_offset,
        "order": args.order,
        "games": args.games,
        "tc": args.tc,
        "threads": args.threads,
        "restart": args.restart,
        "srand": args.srand,
        "sprt": [args.elo0, args.elo1, args.alpha, args.beta],
    }


class ResumeState:
    """Completed game pairs of a shard, saved after every pair.

    Each fastchess invocation is one segment.  A restarted shard skips the
    pairs already played and adds a new segment; totals are the sum over
    segments, and the LLR is the sum of segment LLRs (how Forge combines
    shards as well).
    """

    def __init__(self, path: Path, params: dict[str, object]) -> None:
        self.path = path
        self.params = params
        self.segments: list[dict[str, object]] = []
        # PGN size when the current segment started; see trim_pgn().
        self.pgn_start = 0

    @classmethod
    def load(cls, path: Path, params: dict[str, object]) -> "ResumeState":
        state = cls(path, params)
        try:
            payload = json.loads(path.read_text())
        except (OSError, ValueError):
            return state
        if not isinstance(payload, dict) or payload.get("schema") != RESUME_SCHEMA:
            return state
        if payload.get("params") != json.loads(json.dumps(params)):
            return state
        segments = payload.get("segments")
        if isinstance(segments, list) and all(isinstance(item, dict) for item in segments):
            state.segments = segments
        return state

    def prior(self) -> dict[str, object]:
        totals: dict[str, object] = {
            "pairs": 0, "wins": 0, "draws": 0, "losses": 0,
            "pentanomial": [0, 0, 0, 0, 0], "llr": 0.0,
        }
        for segment in self.segments:
            for key in ("pairs", "wins", "draws", "losses"):
                totals[key] = int(totals[key]) + int(segment.get(key, 0))
            penta = segment.get("pentanomial") or [0] * 5
            totals["pentanomial"] = [a + int(b) for a, b in zip(totals["pentanomial"], penta)]
            totals["llr"] = float(totals["llr"]) + float(segment.get("llr", 0.0))
            if segment.get("ubound"):
                totals["ubound"] = segment["ubound"]
        return totals

    def save(self, current: dict[str, object]) -> None:
        payload = {
            "schema": RESUME_SCHEMA,
            "params": self.params,
            "segments": [*self.segments, {**current, "pgn_start": self.pgn_start}],
        }
        tmp = self.path.with_name(self.path.name + ".tmp")
        with tmp.open("w") as handle:
            json.dump(payload, handle, sort_keys=True)
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp, self.path)


PGN_ROUND_RE = re.compile(r'^\[Round "(?P<round>\d+)"\]', re.MULTILINE)


def trim_pgn(pgn: Path, resume: ResumeState) -> None:
    """Drop PGN games of the last segment that its saved pairs do not cover.

    A killed segment can leave games of unfinished pairs (or pairs past an
    unfinished one) in the PGN; those pairs are replayed, so their earlier
    games would be duplicates.  fastchess numbers rounds per invocation from 1,
    one round per opening pair, so the recorded prefix is rounds 1..pairs.
    """
    if not resume.segments:
        return
    last = resume.segments[-1]
    start = int(last.get("pgn_start", 0))
    keep = int(last.get("pairs", 0))
    try:
        data = pgn.read_text()
    except OSError:
        return
    if start > len(data):
        return
    head, tail = data[:start], data[start:]
    games = [chunk for chunk in re.split(r'(?=^\[Event )', tail, flags=re.MULTILINE) if chunk.strip()]
    kept = []
    for game in games:
        match = PGN_ROUND_RE.search(game)
        if match and int(match["round"]) <= keep and game.rstrip().endswith(("1-0", "0-1", "1/2-1/2", "*")):
            kept.append(game if game.endswith("\n\n") else game.rstrip("\n") + "\n\n")
    trimmed = head + "".join(kept)
    if trimmed != data:
        tmp = pgn.with_name(pgn.name + ".tmp")
        tmp.write_text(trimmed)
        os.replace(tmp, pgn)


def pentanomial_elo_ci(pentanomial: list[int]) -> Optional[tuple[float, float]]:
    """Elo and 95% half-width from pair results (same model as Forge)."""
    pairs = sum(pentanomial)
    if pairs < 2:
        return None
    rate = sum(index * count for index, count in enumerate(pentanomial)) / (4.0 * pairs)
    if not 0.0 < rate < 1.0:
        return None
    variance = sum(count * (index / 4.0 - rate) ** 2 for index, count in enumerate(pentanomial)) / (pairs - 1)
    if variance <= 0.0:
        return None
    elo = 400.0 * math.log10(rate / (1.0 - rate))
    derivative = 400.0 / (math.log(10.0) * rate * (1.0 - rate))
    return elo, 1.96 * math.sqrt(variance / pairs) * derivative


class ProgressFormatter:
    def __init__(
        self,
        total_games: int,
        show_eta: Optional[bool],
        resume: Optional[ResumeState] = None,
    ) -> None:
        self.total_games = total_games
        self.show_eta = show_eta
        self.start_time = time.monotonic()
        self.score: Optional[re.Match[str]] = None
        self.elo: Optional[re.Match[str]] = None
        # Games of a pair can finish out of order (and interleaved with other
        # pairs) when concurrency > 1, so pair them by game number.
        self.open_pairs: dict[int, list[float]] = {}
        self.finished_pairs: dict[int, tuple[float, float]] = {}
        self.next_pair = 0
        self.pentanomial = [0, 0, 0, 0, 0]
        self.resume = resume
        self.prior = resume.prior() if resume is not None else None
        self.resumed = bool(self.prior and int(self.prior["pairs"]))
        self.wdl = [0, 0, 0]
        self.pairs = 0
        self.llr = 0.0
        self.ubound = str(self.prior.get("ubound") or "") if self.prior else ""

    def advance_pairs(self) -> bool:
        """Count finished pairs that extend the contiguous prefix from pair 0.

        Only that prefix is recorded, so a resumed shard can skip exactly
        ``pairs`` openings; pairs finished past a gap are replayed.
        """
        advanced = False
        while self.next_pair in self.finished_pairs:
            first, second = self.finished_pairs.pop(self.next_pair)
            for score in (first, second):
                self.wdl[0 if score == 1.0 else 1 if score == 0.5 else 2] += 1
            self.pentanomial[int(round((first + second) * 2))] += 1
            self.pairs += 1
            self.next_pair += 1
            advanced = True
        return advanced

    def segment(self) -> dict[str, object]:
        wins, draws, losses = self.wdl
        return {
            "pairs": self.pairs,
            "wins": wins,
            "draws": draws,
            "losses": losses,
            "pentanomial": list(self.pentanomial),
            "llr": self.llr,
            "ubound": self.ubound,
        }

    def eta(self, completed: int) -> str:
        played = completed - (2 * int(self.prior["pairs"]) if self.resumed else 0)
        if played <= 0:
            return "?"
        remaining = max(0, self.total_games - completed)
        elapsed = time.monotonic() - self.start_time
        return format_eta(elapsed * remaining / played)

    def format(self, line: str) -> Optional[str]:
        if line.startswith(NOISY_FASTCHESS_PREFIXES):
            return None
        if line.startswith("Started game "):
            return None
        if match := FINISHED_RE.match(line):
            result = match["result"]
            candidate_white = match["white"] == "candidate"
            candidate_score = 0.5
            if result != "1/2-1/2":
                candidate_won = (result == "1-0") == candidate_white
                candidate_score = 1.0 if candidate_won else 0.0
            pair = (int(match["game"]) - 1) // 2
            scores = self.open_pairs.setdefault(pair, [])
            scores.append(candidate_score)
            if len(scores) == 2:
                del self.open_pairs[pair]
                self.finished_pairs[pair] = (scores[0], scores[1])
                if self.advance_pairs() and self.resume is not None:
                    self.resume.save(self.segment())
            return None

        if match := SCORE_RE.match(line):
            self.score = match
            return None
        if match := ELO_RE.match(line):
            self.elo = match
            return None
        if match := SPRT_RE.match(line):
            try:
                self.llr = float(match["llr"])
            except ValueError:
                pass
            self.ubound = match["ubound"]
            if self.resume is not None and self.pairs:
                # Keep the saved LLR current with the pairs already recorded.
                self.resume.save(self.segment())
            if not self.score or not self.elo:
                return line
            if self.resumed:
                return self.combined_line(match["ubound"])
            width = len(str(self.total_games))
            completed = int(self.score["completed"])
            progress_line = (
                f"[{completed:>{width}}/{self.total_games}] "
                f"Elo {format_field(self.elo['elo'], 1, 5)} +/- {format_field(self.elo['err'], 1, 5)} | "
                f"LLR {format_llr(match['llr'], match['ubound'])} | "
                f"LOS {format_field(self.elo['los'], 1, 4)}% | "
                f"WDL {self.score['wins']}/{self.score['draws']}/{self.score['losses']} | "
                f"Ptnml {'-'.join(str(value) for value in self.pentanomial)} | "
                f"draw {format_field(self.elo['draw'], 1, 5)}%"
            )
            progress_with_eta = f"{progress_line} | ETA {self.eta(completed)}"
            terminal_width = shutil.get_terminal_size((120, 20)).columns
            if self.show_eta is True or (self.show_eta is None and len(progress_with_eta) <= terminal_width):
                return f"{progress_with_eta}\n"
            return f"{progress_line}\n"

        if line.startswith("Player:") or line.startswith("   \""):
            return None
        return line

    def combined_line(self, ubound: str) -> str:
        """Progress over all segments of a resumed shard."""
        assert self.prior is not None
        wins, draws, losses = (int(self.prior[key]) + value for key, value in zip(("wins", "draws", "losses"), self.wdl))
        pentanomial = [int(a) + b for a, b in zip(self.prior["pentanomial"], self.pentanomial)]
        completed = wins + draws + losses
        llr = float(self.prior["llr"]) + self.llr
        estimate = pentanomial_elo_ci(pentanomial)
        if estimate is None:
            elo_text, err_text, los_text = "nan", "nan", "nan"
        else:
            elo, ci = estimate
            los = 50.0 * (1.0 + math.erf(elo / (ci / 1.96) / math.sqrt(2.0)))
            elo_text, err_text, los_text = f"{elo:.2f}", f"{ci:.2f}", f"{los:.2f}"
        draw_text = f"{100.0 * draws / completed:.2f}" if completed else "0"
        width = len(str(self.total_games))
        progress_line = (
            f"[{completed:>{width}}/{self.total_games}] "
            f"Elo {format_field(elo_text, 1, 5)} +/- {format_field(err_text, 1, 5)} | "
            f"LLR {format_llr(f'{llr:.2f}', ubound)} | "
            f"LOS {format_field(los_text, 1, 4)}% | "
            f"WDL {wins}/{draws}/{losses} | "
            f"Ptnml {'-'.join(str(value) for value in pentanomial)} | "
            f"draw {format_field(draw_text, 1, 5)}%"
        )
        progress_with_eta = f"{progress_line} | ETA {self.eta(completed)}"
        terminal_width = shutil.get_terminal_size((120, 20)).columns
        if self.show_eta is True or (self.show_eta is None and len(progress_with_eta) <= terminal_width):
            return f"{progress_with_eta}\n"
        return f"{progress_line}\n"


def run_and_tee(
    cmd: list[str],
    log: Path,
    total_games: int,
    show_eta: Optional[bool],
    resume: Optional[ResumeState] = None,
) -> int:
    resumed = bool(resume is not None and int(resume.prior()["pairs"]))
    with log.open("a" if resumed else "w") as log_file:
        progress = ProgressFormatter(total_games, show_eta, resume)
        proc = subprocess.Popen(
            cmd,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            bufsize=1,
        )
        assert proc.stdout is not None
        for line in proc.stdout:
            printable = progress.format(line)
            if printable is not None:
                print(printable, end="", flush=True)
            log_file.write(line)
            log_file.flush()
        return proc.wait()


def last_matching_line(log: Path, prefix: str) -> str:
    result = ""
    if not log.is_file():
        return result
    for line in log.read_text(errors="ignore").splitlines():
        if line.startswith(prefix):
            result = line
    return result


def warning_summary(log: Path) -> str:
    counts: dict[str, int] = {}
    if not log.is_file():
        return "Warnings: log unavailable"
    for line in log.read_text(errors="ignore").splitlines():
        if not line.startswith("Warning;"):
            continue
        warning = line.strip().removeprefix("Warning; ")
        warning = warning.split(" - move ", 1)[0]
        counts[warning] = counts.get(warning, 0) + 1
    if not counts:
        return "Warnings: none"

    total = sum(counts.values())
    details = ", ".join(f"{name}={count}" for name, count in sorted(counts.items()))
    return f"Warnings: {total} ({details})"


def main() -> int:
    args = parse_args()
    expand_user_paths(args)

    require_executable(args.candidate, "Candidate")
    require_executable(args.reference, "Reference")
    require_file(args.book, "Opening book")

    logs_dir = Path(args.log_dir)
    logs_dir.mkdir(exist_ok=True)
    log = logs_dir / f"{args.name}.log"
    pgn = logs_dir / f"{args.name}.pgn"

    # Completed pairs are saved as they finish, so a killed shard (OOM,
    # preemption, a lost host) continues where it stopped when rerun.
    state_path = logs_dir / f"{args.name}.resume.json"
    params = resume_params(args)
    if not args.resume:
        state_path.unlink(missing_ok=True)
    resume = ResumeState.load(state_path, params)
    prior = resume.prior()
    pairs_done = int(prior["pairs"])

    start_msg = startup_message(args)
    if pairs_done:
        start_msg += f"\nresume: {2 * pairs_done} games already played"
    print(f"{start_msg}\n")
    post_ntfy(args.ntfy_url, start_msg)

    if pairs_done >= total_rounds(args.games):
        trim_pgn(pgn, resume)
        done = ProgressFormatter(args.games, True, resume)
        print(done.combined_line(str(prior.get("ubound") or "nan")), end="", flush=True)
        state_path.unlink(missing_ok=True)
        return 0
    if pairs_done:
        trim_pgn(pgn, resume)
    resume.pgn_start = pgn.stat().st_size if pairs_done and pgn.exists() else 0
    status = run_and_tee(build_command(args, pgn, pairs_done=pairs_done), log, args.games, args.eta, resume)
    if status == 0:
        state_path.unlink(missing_ok=True)
    time.sleep(1)
    score_line = last_matching_line(log, "Score of candidate vs reference")
    elo_line = last_matching_line(log, "Elo difference")
    sprt_line = last_matching_line(log, "SPRT: llr")
    warnings_line = warning_summary(log)
    print(warnings_line)
    summary = "\n".join([
        score_line or "no final score",
        elo_line or "no Elo",
        sprt_line or "no SPRT line",
        warnings_line,
        f"Log: {log}",
    ])
    final_message = f"SPRT {args.name} ({status}):\n{summary}"
    post_ntfy(args.ntfy_url, final_message, title="SPRT finished")

    return status


if __name__ == "__main__":
    raise SystemExit(main())
