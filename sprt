class SprtHelpFormatter(argparse.ArgumentDefaultsHelpFormatter):
    def __init__(self, prog: str) -> None:
        super().__init__(prog, max_help_position=32, width=120)

    def _get_help_string(self, action: argparse.Action) -> str:
        help_text = action.help or ""
        if "%(default)" in help_text:
            return help_text
        if action.default is True:
            return f"{help_text} (default: enabled)"
        if action.default is False:
            return f"{help_text} (default: disabled)"
        if action.default is None:
            return help_text
        if action.default == "":
            return f"{help_text} (default: empty)"
        if action.default == []:
            return f"{help_text} (default: none)"
        return super()._get_help_string(action)


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Run an SPRT with fastchess",
        formatter_class=SprtHelpFormatter,
    )
    parser.add_argument("--candidate", "-c", required=True,
                        help="candidate UCI engine executable")
    parser.add_argument("--reference", "-r", default=DEFAULT_REFERENCE,
                        help="reference UCI engine executable")
    parser.add_argument("--candidate-opts", action="append", default=[], metavar="ARGS",
                        help="extra process args for the candidate engine; repeatable")
    parser.add_argument("--reference-opts", action="append", default=[], metavar="ARGS",
                        help="extra process args for the reference engine; repeatable")
    parser.add_argument("--candidate-uci", action="append", default=[], metavar="NAME=VAL",
                        help="extra UCI option for the candidate engine; repeatable")
    parser.add_argument("--reference-uci", action="append", default=[], metavar="NAME=VAL",
                        help="extra UCI option for the reference engine; repeatable")
    parser.add_argument("--book", default=DEFAULT_BOOK,
                        help="opening book file")
    parser.add_argument("--games", type=int, default=DEFAULT_GAMES,
                        help="target number of games")
    parser.add_argument("--concurrency", type=int, default=DEFAULT_CONCURRENCY,
                        help="parallel games")
    parser.add_argument("--threads", "-t", type=int, default=DEFAULT_THREADS,
                        help="engine Threads option")
    parser.add_argument("--tc", default="10+0.1",
                        help="fastchess time control passed to -each")
    parser.add_argument("--book-format", default="epd",
                        help="fastchess opening book format")
    parser.add_argument("--fastchess", default="",
                        help="fastchess executable path; empty searches PATH")
    parser.add_argument("--log-dir", default="logs",
                        help="directory for raw fastchess logs and PGNs")
    parser.add_argument("--ntfy-url", default=os.environ.get("SPRT_NTFY_URL", ""),
                        help="ntfy topic URL for start/end notifications")
    parser.add_argument("--no-ntfy", action="store_true",
                        help="suppress all ntfy notifications; use only for distributed shards")
    parser.add_argument("--name", "-n", default="sprt",
                        help="run name used for log and PGN filenames")
    parser.add_argument("--elo0", type=float, default=0.0, help="SPRT null hypothesis Elo")
    parser.add_argument("--elo1", type=float, default=5.0, help="SPRT test hypothesis Elo")
    parser.add_argument("--alpha", type=float, default=0.10, help="SPRT false-positive rate")
    parser.add_argument("--beta", type=float, default=0.10, help="SPRT false-negative rate")
    parser.add_argument("--restart", choices=["on", "off"], default="on",
                        help="fastchess engine restart mode")
    parser.add_argument("--order", default="random",
                        help="fastchess opening order")
    parser.add_argument("--book-offset", type=int, default=0,
                        help="zero-based opening-book offset")
    parser.add_argument("--no-resume", dest="resume", action="store_false", default=True,
                        help="ignore and overwrite a saved partial run instead of continuing it")
    parser.add_argument("--srand", default="",
                        help="fastchess random seed; empty lets fastchess choose")
    eta_group = parser.add_mutually_exclusive_group()
    eta_group.add_argument("--eta", dest="eta", action="store_true", default=True, help="always show progress ETA")
    eta_group.add_argument("--no-eta", dest="eta", action="store_false", default=argparse.SUPPRESS,
                           help="hide progress ETA")
    argv, candidate_opts, reference_opts = extract_process_opts(sys.argv[1:], parser)
    args = parser.parse_args(argv)
    args.candidate_opts = parse_process_opts(candidate_opts, "--candidate-opts")
    args.reference_opts = parse_process_opts(reference_opts, "--reference-opts")
    if args.book_offset < 0:
        parser.error("--book-offset must be non-negative")
    if args.no_ntfy:
        args.ntfy_url = ""
    return args


def extract_process_opts(
    argv: list[str],
    parser: argparse.ArgumentParser,
) -> tuple[list[str], list[str], list[str]]:
    filtered = []
    candidate_opts = []
    reference_opts = []
    i = 0
    while i < len(argv):
        arg = argv[i]
        if arg == "--candidate-opts":
            if i + 1 >= len(argv):
                parser.error("--candidate-opts expected one argument")
            candidate_opts.append(argv[i + 1])
            i += 2
            continue
        if arg.startswith("--candidate-opts="):
            candidate_opts.append(arg.split("=", 1)[1])
            i += 1
            continue
        if arg == "--reference-opts":
            if i + 1 >= len(argv):
                parser.error("--reference-opts expected one argument")
            reference_opts.append(argv[i + 1])
            i += 2
            continue
        if arg.startswith("--reference-opts="):
            reference_opts.append(arg.split("=", 1)[1])
            i += 1
            continue
        filtered.append(arg)
        i += 1
    return filtered, candidate_opts, reference_opts


def parse_process_opts(values: list[str], label: str) -> list[str]:
    parsed = []
    for value in values:
        try:
            parsed.extend(shlex.split(value))
        except ValueError as ex:
            print(f"{label} is invalid: {ex}", file=sys.stderr)
            sys.exit(1)
    return parsed


def expand_user_paths(args: argparse.Namespace) -> None:
    args.candidate = os.path.expanduser(args.candidate)
    args.reference = os.path.expanduser(args.reference)
    args.book = os.path.expanduser(args.book)
    args.fastchess = os.path.expanduser(args.fastchess)
    args.log_dir = os.path.expanduser(args.log_dir)
    args.candidate_opts = [os.path.expanduser(opt) for opt in args.candidate_opts]
    args.reference_opts = [os.path.expanduser(opt) for opt in args.reference_opts]


def find_fastchess(path: str) -> list[str]:
    if path:
        if os.path.isfile(path) and os.access(path, os.X_OK):
            return [path]
        print(f"fastchess is not executable: {path}", file=sys.stderr)
        sys.exit(1)

    found = shutil.which("fastchess")
    if found:
        return [found]

    print("fastchess not found in PATH; pass --fastchess to specify it", file=sys.stderr)
    sys.exit(1)


def require_executable(path: str, label: str) -> None:
    if not os.path.isfile(path) or not os.access(path, os.X_OK):
        print(f"{label} engine is not executable: {path}", file=sys.stderr)
        sys.exit(1)


def require_file(path: str, label: str) -> None:
    if not os.path.isfile(path):
        print(f"{label} not found: {path}", file=sys.stderr)
        sys.exit(1)


def engine_display(command: str, process_opts: list[str]) -> str:
    if not process_opts:
        return command
    return f"{command} {shlex.join(process_opts)}"


def engine_id(command: str, process_opts: list[str]) -> str:
    try:
        proc = subprocess.Popen(
            [command, *process_opts],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.STDOUT,
            text=True,
            errors="replace",
        )
    except OSError:
        return ""

    try:
        stdout, _ = proc.communicate("uci\nquit\n", timeout=ENGINE_ID_TIMEOUT)
    except subprocess.TimeoutExpired:
        proc.kill()
        stdout, _ = proc.communicate()

    lines = [line.strip() for line in stdout.splitlines() if line.strip()]
    for line in lines:
        if line.startswith("id name "):
            return line.removeprefix("id name ").strip()
    for line in lines:
        if line.startswith("id ") and not line.startswith("id author "):
            return line.removeprefix("id ").strip()
    return ""


def add_engine_header(lines: list[str], role: str, command: str, process_opts: list[str]) -> None:
    display = engine_display(command, process_opts)
    name = engine_id(command, process_opts)
    if name:
        lines.append(f"{role}: {display} ({name})")
        return
    lines.append(f"{role}: {display}")


def run_field(name: str, value: object, source: str = "") -> str:
    field = f"{name}: {value}"
    if source:
        return f"{field} ({source})"
    return field


def startup_message(args: argparse.Namespace) -> str:
    lines: list[str] = []
    add_engine_header(lines, "candidate", args.candidate, args.candidate_opts)
    add_engine_header(lines, "reference", args.reference, args.reference_opts)
    lines.extend([
        run_field("games", args.games),
        run_field("tc", args.tc),
        run_field("concurrency", args.concurrency, getattr(args, "concurrency_source", "")),
        run_field("threads", args.threads, getattr(args, "threads_source", "")),
        run_field("elo", f"{args.elo0:g}/{args.elo1:g}"),
    ])
    return "\n".join(lines)


def load_ntfy_auth() -> str:
    if os.environ.get("NTFY_AUTH"):
        return os.environ["NTFY_AUTH"]
    if os.environ.get("LICHESS_NTFY_AUTH"):
        return os.environ["LICHESS_NTFY_AUTH"]

    ntfy_file = Path.home() / ".ntfy"
    if not ntfy_file.is_file():
        return ""

    for line in ntfy_file.read_text(errors="ignore").splitlines():
        line = line.strip()
        if line.startswith("export "):
            line = line[7:]
        if line.startswith("NTFY_AUTH="):
            value = line.split("=", 1)[1].strip()
        elif line.startswith("LICHESS_NTFY_AUTH="):
            value = line.split("=", 1)[1].strip()
        else:
            continue
        if (value.startswith('"') and value.endswith('"')) or (value.startswith("'") and value.endswith("'")):
            value = value[1:-1]
        return value
    return ""


def post_ntfy(url: str, message: str, *, title: str = "") -> bool:
    if not url:
        return True

    data = message.encode()
    req = urllib.request.Request(url, data=data, method="POST")
    if title:
        req.add_header("Title", title)
    auth = load_ntfy_auth()
    if auth:
        token = base64.b64encode(auth.encode()).decode()
        req.add_header("Authorization", f"Basic {token}")

    try:
        urllib.request.urlopen(req, timeout=10).close()
    except (OSError, urllib.error.URLError):
        print(f"ntfy post failed: {url}", file=sys.stderr)
        return False
    return True


def engine_args(name: str, command: str, process_opts: list[str], threads: int, restart: str,
                extra_options: list[str]) -> list[str]:
    args = [
        "-engine",
        f"name={name}",
        "proto=uci",
        f"restart={restart}",
        f"cmd={command}",
        f"option.Threads={threads}",
    ]
    if process_opts:
        args.append(f"args={shlex.join(process_opts)}")
    args.extend(f"option.{opt}" for opt in extra_options)
    return args


def total_rounds(games: int) -> int:
    return max(1, (games + 1) // 2)


def build_command(args: argparse.Namespace, log_pgn: Path, *, pairs_done: int = 0) -> list[str]:
    rounds = max(1, total_rounds(args.games) - pairs_done)
    cmd = find_fastchess(args.fastchess)
    cmd += [
        "-openings",
        f"file={args.book}",
        f"format={args.book_format}",
        f"order={args.order}",
        f"start={args.book_offset + pairs_done + 1}",
        *engine_args("candidate", args.candidate, args.candidate_opts, args.threads,
                     args.restart, args.candidate_uci),
        *engine_args("reference", args.reference, args.reference_opts, args.threads,
                     args.restart, args.reference_uci),
        "-concurrency",
        str(args.concurrency),
        "-ratinginterval",
        "2",
        "-rounds",
        str(rounds),
        "-repeat",
        "-pgnout",
        f"file={log_pgn}",
        "notation=san",
        f"append={'true' if pairs_done else 'false'}",
        "-each",
        f"tc={args.tc}",
        "-config",
        f"outname={os.devnull}",
        "-autosaveinterval",
        "0",
        "-recover",
        "-output",
        "format=cutechess",
        "-sprt",
        f"elo0={args.elo0:g}",
        f"elo1={args.elo1:g}",
        f"alpha={args.alpha:g}",
        f"beta={args.beta:g}",
    ]
    if args.srand:
        cmd += ["-srand", args.srand]
    return cmd


